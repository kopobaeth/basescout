{
  "rewrites": [
    {
      "source": "/api/v1/report",
      "destination": "/api/scan?reportVersion=1"
    },
    {
      "source": "/trending",
      "destination": "/index.html"
    },
    {
      "source": "/basepaint",
      "destination": "/index.html"
    },
    {
      "source": "/basepaint/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/token/:address",
      "destination": "/index.html"
    }
  ]
}
